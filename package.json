{
  "name": "@pawover/kit",
  "author": {
    "name": "pawover",
    "email": "pawover@outlook.com",
    "url": "https://github.com/pawover"
  },
  "description": "一个基于 TypeScript 的开发工具包",
  "version": "0.9.1-alpha.4",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0"
    }
  },
  "keywords": [
    "pawover",
    "pawover-kit"
  ],
  "homepage": "https://github.com/pawover/pawover-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawover/pawover-kit.git"
  },
  "license": "MIT",
  "main": "./entry/index.cjs",
  "module": "./entry/index.js",
  "types": "./entry/index.d.ts",
  "files": [
    "entry"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./entry/index.d.ts",
        "default": "./entry/index.js"
      },
      "require": {
        "types": "./entry/index.d.cts",
        "default": "./entry/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./entry/index.d.ts",
        "default": "./entry/index.js"
      },
      "require": {
        "types": "./entry/index.d.cts",
        "default": "./entry/index.cjs"
      }
    },
    "./math": {
      "import": {
        "types": "./entry/math.d.ts",
        "default": "./entry/math.js"
      },
      "require": {
        "types": "./entry/math.d.cts",
        "default": "./entry/math.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./entry/vite.d.ts",
        "default": "./entry/vite.js"
      },
      "require": {
        "types": "./entry/vite.d.cts",
        "default": "./entry/vite.cjs"
      }
    },
    "./utils/math": {
      "import": {
        "types": "./entry/math.d.ts",
        "default": "./entry/math.js"
      },
      "require": {
        "types": "./entry/math.d.cts",
        "default": "./entry/math.cjs"
      }
    },
    "./utils/vite": {
      "import": {
        "types": "./entry/vite.d.ts",
        "default": "./entry/vite.js"
      },
      "require": {
        "types": "./entry/vite.d.cts",
        "default": "./entry/vite.cjs"
      }
    },
    "./hooks/react": {
      "import": {
        "types": "./entry/hooks-react.d.ts",
        "default": "./entry/hooks-react.js"
      },
      "require": {
        "types": "./entry/hooks-react.d.cts",
        "default": "./entry/hooks-react.cjs"
      }
    },
    "./hooks/alova": {
      "import": {
        "types": "./entry/hooks-alova.d.ts",
        "default": "./entry/hooks-alova.js"
      },
      "require": {
        "types": "./entry/hooks-alova.d.cts",
        "default": "./entry/hooks-alova.cjs"
      }
    },
    "./hooks/metadata.json": "./entry/hooks-metadata.json",
    "./zod": {
      "import": {
        "types": "./entry/zod.d.ts",
        "default": "./entry/zod.js"
      },
      "require": {
        "types": "./entry/zod.d.cts",
        "default": "./entry/zod.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./entry/types.d.ts",
        "default": "./entry/types.js"
      },
      "require": {
        "types": "./entry/types.d.cts",
        "default": "./entry/types.cjs"
      }
    },
    "./types/react": {
      "import": {
        "types": "./entry/types-react.d.ts",
        "default": "./entry/types-react.js"
      },
      "require": {
        "types": "./entry/types-react.d.cts",
        "default": "./entry/types-react.cjs"
      }
    },
    "./eslint-rules": {
      "import": {
        "types": "./entry/eslint-rules.d.ts",
        "default": "./entry/eslint-rules.js"
      },
      "require": {
        "types": "./entry/eslint-rules.d.cts",
        "default": "./entry/eslint-rules.cjs"
      }
    },
    "./metadata.json": "./entry/metadata.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:types": "tsc -p test/tsconfig.json --noEmit",
    "test:smoke": "node test/scripts/smoke.mjs",
    "test:ci": "pnpm test:types && pnpm test && pnpm build && pnpm test:smoke && pnpm check:pack",
    "postbuild": "node scripts/sync-entry.ts",
    "build": "turbo build",
    "build:force": "turbo build --force",
    "build:package": "turbo build:package && pnpm package",
    "build:package:force": "turbo build:package --force && pnpm package",
    "package": "pnpm pack",
    "public": "turbo build && pnpm publish --access public",
    "changeset": "changeset",
    "ci:version": "pnpm changeset version && node scripts/bump-root.mjs && pnpm install",
    "ci:publish": "pnpm build && pnpm changeset publish",
    "pre:enter-alpha": "pnpm changeset pre enter alpha",
    "pre:exit": "pnpm changeset pre exit",
    "release:merge": "node scripts/release-merge.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:gen": "node scripts/generate-docs.mjs",
    "check": "pnpm check:types & pnpm check:eslint & pnpm check:format",
    "check:types": "tsc --noEmit",
    "check:eslint": "eslint --fix \"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,vue}\" --cache-location=.cache/eslint.cache.json --cache",
    "check:format": "prettier --write \"**/*.{html,json,jsonc}\" --cache-location=.cache/prettier.cache.json --cache",
    "check:pack": "cross-env HUSKY=0 node scripts/check-pack.mjs",
    "clean": "pnpm clean:cache & pnpm clean:lib & pnpm clean:output",
    "clean:turbo": "rimraf -g **/.turbo",
    "clean:cache": "rimraf -g .cache",
    "clean:lib": "rimraf -g node_modules",
    "clean:output": "rimraf -g **/dist **/*.tgz",
    "lib:up": "pnpm dlx taze -I -r --exclude pnpm",
    "prepare": "husky",
    "commit": "git cz"
  },
  "dependencies": {
    "@pawover/kit-eslint-rules": "workspace:*",
    "@pawover/kit-hooks": "workspace:*",
    "@pawover/kit-types": "workspace:*",
    "@pawover/kit-utils": "workspace:*",
    "@pawover/kit-zod": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^6.0.0-beta.5",
    "@testing-library/react": "^16.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "alova": "^3.5.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-antfu": "^3.2.3",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "mathjs": "^15.2.0",
    "prettier": "^3.9.6",
    "react-dom": "19.2.6",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "alova": "^3.5.1",
    "mathjs": "^15.0.0",
    "react": "^19.2.0",
    "vite": "^7 || ^8",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "alova": {
      "optional": true
    },
    "mathjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "cz.config.cjs"
    }
  }
}
