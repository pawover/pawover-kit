{
  "name": "@pawover/kit-zod",
  "author": {
    "name": "pawover",
    "email": "pawover@outlook.com",
    "url": "https://github.com/pawover"
  },
  "description": "Zod v4 schemas: id, string, number, boolean and bigint validators",
  "version": "0.0.4",
  "type": "module",
  "keywords": [
    "pawover",
    "pawover-kit-zod"
  ],
  "homepage": "https://github.com/pawover/pawover-kit/packages/zod#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawover/pawover-kit.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "build:source": "tsdown",
    "package": "pnpm pack",
    "public": "pnpm publish --access public --tag alpha",
    "check:pack": "pnpm dlx @arethetypeswrong/cli --pack . --profile node16"
  },
  "devDependencies": {
    "@pawover/kit-internal": "workspace:*",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  }
}
