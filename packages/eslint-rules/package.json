{
  "name": "@pawover/kit-eslint-rules",
  "author": {
    "name": "pawover",
    "email": "pawover@outlook.com",
    "url": "https://github.com/pawover"
  },
  "description": "Self-contained ESLint flat config preset: javascript, typescript, react, vue, stylistic, antfu and import rules, with pinned bundled plugins",
  "version": "0.2.0-alpha.0",
  "type": "module",
  "keywords": [
    "pawover",
    "pawover-kit-eslint-rules"
  ],
  "homepage": "https://github.com/pawover/pawover-kit/packages/eslint-rules#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawover/pawover-kit.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.2"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build:source": "tsdown",
    "package": "pnpm pack",
    "public": "pnpm publish --access public --tag alpha",
    "check:pack": "pnpm dlx @arethetypeswrong/cli --pack . --profile node16"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@stylistic/eslint-plugin": "6.0.0-beta.6",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-plugin-antfu": "3.3.1",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.1"
  },
  "devDependencies": {
    "@pawover/kit-internal": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
