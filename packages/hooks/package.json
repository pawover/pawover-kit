{
  "name": "@pawover/kit-hooks",
  "author": {
    "name": "pawover",
    "email": "pawover@outlook.com",
    "url": "https://github.com/pawover"
  },
  "description": "React hooks (mount, unmount, latest, title, responsive) and Alova request hooks",
  "version": "0.0.8",
  "type": "module",
  "keywords": [
    "pawover",
    "pawover-kit-hooks"
  ],
  "homepage": "https://github.com/pawover/pawover-kit/packages/hooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawover/pawover-kit.git"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./alova": {
      "import": {
        "types": "./src/alova/index.ts",
        "default": "./src/alova/index.ts"
      },
      "require": {
        "types": "./src/alova/index.ts",
        "default": "./src/alova/index.ts"
      }
    },
    "./react": {
      "import": {
        "types": "./src/react/index.ts",
        "default": "./src/react/index.ts"
      },
      "require": {
        "types": "./src/react/index.ts",
        "default": "./src/react/index.ts"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./alova": {
        "import": {
          "types": "./dist/alova.d.ts",
          "default": "./dist/alova.js"
        },
        "require": {
          "types": "./dist/alova.d.cts",
          "default": "./dist/alova.cjs"
        }
      },
      "./react": {
        "import": {
          "types": "./dist/react.d.ts",
          "default": "./dist/react.js"
        },
        "require": {
          "types": "./dist/react.d.cts",
          "default": "./dist/react.cjs"
        }
      }
    }
  },
  "scripts": {
    "build:source": "tsdown",
    "package": "pnpm pack",
    "public": "pnpm publish --access public --tag alpha",
    "check:pack": "pnpm dlx @arethetypeswrong/cli --pack . --profile node16"
  },
  "dependencies": {
    "@pawover/kit-types": "workspace:*",
    "@pawover/kit-utils": "workspace:*",
    "es-toolkit": "^1.51.0",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@pawover/kit-internal": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^19.2.14",
    "alova": "^3.5.5",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "alova": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
