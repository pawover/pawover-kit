{
  "name": "@pawover/kit-utils",
  "author": {
    "name": "pawover",
    "email": "pawover@outlook.com",
    "url": "https://github.com/pawover"
  },
  "description": "Static utility classes: array, string, object, tree, currency, date, math and more",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "pawover",
    "pawover-kit-utils"
  ],
  "homepage": "https://github.com/pawover/pawover-kit/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawover/pawover-kit.git"
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./math": {
      "development": "./src/math/index.ts",
      "import": {
        "types": "./dist/math.d.ts",
        "default": "./dist/math.js"
      },
      "require": {
        "types": "./dist/math.d.cts",
        "default": "./dist/math.cjs"
      }
    },
    "./vite": {
      "development": "./src/vite/index.ts",
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./metadata.json": "./dist/metadata.json"
  },
  "scripts": {
    "build:source": "tsdown",
    "build:metadata": "node scripts/metadata.ts",
    "package": "pnpm pack",
    "public": "pnpm publish --access public --tag alpha",
    "check:pack": "pnpm dlx @arethetypeswrong/cli --pack . --profile node16"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pawover/kit-types": "workspace:*",
    "ts-toolbelt": "^9.6.0",
    "type-fest": "^5.8.0"
  },
  "peerDependencies": {
    "mathjs": "^15.2.0",
    "vite": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "mathjs": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
